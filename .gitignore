# --- SEGURIDAD ---
# Documentos con datos sensibles
.env

# --- PYTHON ---
# Archivos temporales de compilación de Python
__pycache__/
*.py[cod]
*$py.class

# --- JUPYTER ---
# Archivos temporales que crea Jupyter al guardar
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- SISTEMA ---
.DS_Store
Thumbs.db

# --- ENTORNOS VIRTUALES ---
# Entornos temporales para instalar las librerías
venv/
.venv/
env/

# --- DATOS ---
# La descarga bruta de las APIs es regenerable, no se versiona.
# El dataset final de data/processed/ sí, para que los notebooks 02-05
# corran en un clon recién hecho sin necesidad de una API key de FRED.
data/raw/*
!data/raw/.gitkeep

# --- DISTRIBUCIÓN ---
# Archivos HTML
*.html